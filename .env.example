# Fuzal — environment configuration (copy to .env)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# Gameplay
FUZAL_MAX_PLAYERS=5
FUZAL_MEMORY_SECONDS=30
FUZAL_GRID_COLS=4
FUZAL_GRID_ROWS=4

# Canonical public origin embedded in QR codes (leave blank to use browser origin)
NEXT_PUBLIC_SITE_URL=

# FastAPI only: JSON list of allowed CORS origins
# FUZAL_CORS_ORIGINS=["https://fuzal.example.com"]
