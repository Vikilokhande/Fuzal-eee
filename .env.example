# Fuzal — environment configuration (copy to .env)

# PostgreSQL (used by the Next.js Drizzle layer; game state itself is in-memory
# behind the swappable LobbyRepository interface)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Gameplay
FUZAL_MAX_PLAYERS=5
FUZAL_MEMORY_SECONDS=30
FUZAL_GRID_COLS=4
FUZAL_GRID_ROWS=4

# Canonical public origin embedded in QR codes (leave blank to use the
# browser's current origin — never hardcode localhost in production)
NEXT_PUBLIC_SITE_URL=

# FastAPI only: JSON list of allowed CORS origins
# FUZAL_CORS_ORIGINS=["https://fuzal.example.com"]
